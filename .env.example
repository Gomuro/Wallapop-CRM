# Next UI (Vercel). Only NEXT_PUBLIC_* — the browser can see these.
# API secrets: server/.env.example → server/.env (never here, never on Vercel).

# Express API origin (browser calls with credentials: 'include').
# Local: http://localhost:4000 — set server/.env CORS_ORIGIN=http://localhost:3000
# Vercel preview/prod: https://your-api.example — add each UI origin to server CORS_ORIGIN;
#   COOKIE_SAMESITE=none and COOKIE_SECURE=true on the API for cross-site session cookies.
NEXT_PUBLIC_API_URL="http://localhost:4000"
