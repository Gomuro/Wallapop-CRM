# Next UI (Vercel). Only NEXT_PUBLIC_* — the browser can see these.
# API secrets: server/.env.example → server/.env (never here, never on Vercel).

# Production on Vercel without buying a domain: keep the browser on this
# origin (HTTPS) and proxy to the Windows VPS. Set on Vercel (all environments):
#   NEXT_PUBLIC_API_PROXY=1
#   API_UPSTREAM=http://YOUR_VPS_IP:4000
# Then remove NEXT_PUBLIC_API_URL (or leave it unset) so the UI never calls http://.

# Local: browser talks to Express directly.
# NEXT_PUBLIC_API_URL="http://localhost:4000"
# API_UPSTREAM is unused locally; server/.env CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
