# Copy to .env and replace with real values.
# Prisma loads DATABASE_URL via prisma7.config.ts (import "dotenv/config").

# VPS Postgres (Docker) or local
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wallapop_crm?schema=public"

# Local/volume photo storage (default: public/uploads)
# UPLOAD_DIR="D:\\data\\wallapop-uploads"

# Optional: Vercel frontend origin for API CORS (Phase 1 auth)
# CORS_ORIGIN="https://your-app.vercel.app"
