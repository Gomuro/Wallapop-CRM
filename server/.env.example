# Express API + Prisma (VPS). Copy to server/.env
# Next/Vercel must not have these keys. Contract: server/API.md

# Local Docker: npm run db:up (server/docker-compose.yml, host 5436 → 5432).
DATABASE_URL="postgresql://wallapop:wallapop@127.0.0.1:5436/wallapop_crm?schema=public"

# Ops CLI only (`npm run ops`). Express ignores these.
# ssh -N -L 5437:127.0.0.1:5432 user@vps   then point VPS URL at the tunnel port.
# OPS_SSH="user@vps"
# OPS_TUNNEL_PORT=5437
# DATABASE_URL_VPS="postgresql://USER:PASS@127.0.0.1:5437/wallapop_crm?schema=public"

# Photo files on this machine (VPS disk). Not the Next/Vercel volume.
UPLOAD_DIR="public/uploads"

# D8 dumps (not web-root). npm run ops -- backup / GET /api/v1/backups
# BACKUP_DIR="C:\\Wallapop-CRM\\backups"
# BACKUP_VIA_DOCKER=true
# PG_DUMP="pg_dump"

# Listen. Default 4000 (Next UI is :3000).
PORT=4000

# Auth. Change JWT_SECRET and seed password before any real login.
JWT_SECRET="change-me"
SEED_USER_EMAIL="operator@example.com"
SEED_USER_PASSWORD="local-dev-only"
SEED_USER_NAME="Operator"

# Cookie for UI (localhost:3000 or Vercel) → this API.
# none + Secure works on http://localhost in Chromium.
COOKIE_SAMESITE="none"
COOKIE_SECURE="true"

# Next UI origin(s), comma-separated.
CORS_ORIGIN="http://localhost:3000"

# Wallapop Chrome — TEMPORARY single-account MVP (NOT final multi-account design).
# One global CDP URL + one user-data-dir for the whole API process.
# Multi-account later: per-Account user-data-dir + separate CDP port (do NOT share one WALLAPOP_CDP_URL).
# See server/API.md → Accounts → browser profiles.
# WALLAPOP_CDP_URL="http://127.0.0.1:9222"
# WALLAPOP_CDP_PORT=9222
# WALLAPOP_CHROME_USER_DATA_DIR="%USERPROFILE%\\ChromeCDP-Persistent"
# WALLAPOP_CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Publish — dry-run stops before Publicar unless this is exactly false (safe default).
# Set to false only for a deliberate live publish. See server/API.md → Publish.
# WALLAPOP_PUBLISH_DRY_RUN=true

# Autopost queue: Start/Stop is in the CRM UI (/accounts). Env no longer enables the loop.
# Live Publicar still requires WALLAPOP_PUBLISH_DRY_RUN=false.
# WALLAPOP_AUTOPOST=true
# Fallback if the default account has no UI interval (accounts.autopost_interval_ms).
# WALLAPOP_AUTOPOST_INTERVAL_MS=900000

# Stale POSTING after Chrome crash: older than N ms → READY_TO_POST (then queue retry).
# After WALLAPOP_POSTING_MAX_ATTEMPTS claims without ACTIVE → FAILED.
# WALLAPOP_POSTING_STALE_MS=1200000
# WALLAPOP_POSTING_MAX_ATTEMPTS=3

