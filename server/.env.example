# Express API + Prisma (VPS). Copy to server/.env
# Next/Vercel must not have these keys. Contract: server/API.md

# Local Docker: npm run db:up (server/docker-compose.yml, host 5436 → 5432).
DATABASE_URL="postgresql://wallapop:wallapop@127.0.0.1:5436/wallapop_crm?schema=public"

# Photo files on this machine (VPS disk). Not the Next/Vercel volume.
UPLOAD_DIR="public/uploads"

# Listen. Default 4000 (Next UI is :3000).
PORT=4000

# Auth. Change JWT_SECRET and seed password before any real login.
JWT_SECRET="change-me"
SEED_USER_EMAIL="operator@example.com"
SEED_USER_PASSWORD="local-dev-only"
SEED_USER_NAME="Operator"

# Cookie for UI (localhost:3000 or Vercel) → this API.
# none + Secure works on http://localhost in Chromium.
COOKIE_SAMESITE="none"
COOKIE_SECURE="true"

# Next UI origin(s), comma-separated.
CORS_ORIGIN="http://localhost:3000"
