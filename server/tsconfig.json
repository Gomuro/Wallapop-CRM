{
  "exclude": ["tests/**"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "ops/**/*.ts", "vitest.config.ts"]
}
