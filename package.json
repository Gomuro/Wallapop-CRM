{
  "name": "wallapop-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --config server/prisma.config.ts",
    "db:generate": "prisma generate --config server/prisma.config.ts",
    "db:validate": "prisma validate --config server/prisma.config.ts",
    "db:up": "docker compose -f server/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f server/docker-compose.yml down",
    "db:migrate": "prisma migrate dev --config server/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config server/prisma.config.ts",
    "db:push": "prisma db push --config server/prisma.config.ts",
    "db:setup": "docker compose -f server/docker-compose.yml up -d --wait && prisma migrate deploy --config server/prisma.config.ts && npx tsx server/prisma/seed.ts",
    "db:seed": "npx tsx server/prisma/seed.ts",
    "db:seed:check": "npx tsx server/prisma/seed.ts --dry-run",
    "db:categories:fetch": "npx tsx server/prisma/fetch-wallapop-categories.ts",
    "server:dev": "tsx server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "server:smoke": "tsx server/scripts/smoke.ts",
    "test:api": "vitest run --config server/vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "heic2any": "^0.0.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
